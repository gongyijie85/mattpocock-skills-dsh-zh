{
  "name": "mattpocock-skills-dsh-zh",
  "description": "Matt Pocock 技能中文版 for DeepSeek Harness: 25 个技能(grilling、writing-for-agents、wait-what、TDD、code-review 等)正文全部译为中文,适配 DSH 的 Cordis 插件架构。Chinese translation of the full promoted mattpocock/skills set (MIT, (c) Matt Pocock)",
  "version": "0.1.4",
  "private": false,
  "type": "module",
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongyijie85/mattpocock-skills-dsh-zh.git"
  },
  "homepage": "https://github.com/gongyijie85/mattpocock-skills-dsh-zh",
  "bugs": {
    "url": "https://github.com/gongyijie85/mattpocock-skills-dsh-zh/issues"
  },
  "scripts": {
    "verify": "node scripts/verify-provider.mjs",
    "prepublishOnly": "node scripts/verify-provider.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skills",
    "mattpocock",
    "aihero",
    "chinese",
    "中文"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.0.1-rc.1": "incompatible",
        "0.0.1-rc.2": "incompatible",
        "0.0.1-rc.5": "incompatible",
        "0.1.0-rc.2": "incompatible",
        "0.1.0-rc.3": "incompatible",
        "0.1.0-rc.6": "compatible",
        "0.1.0-rc.7": "compatible",
        "0.1.0-rc.8": "compatible",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.2": "compatible",
        "0.1.2-alpha.3": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.2": "compatible",
        "0.1.5-alpha.1": "compatible",
        "0.1.5-alpha.2": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      }
    }
  }
